    {"from": "a.html", "href": "../b.html", "to": null, "helper": "todo"},
    {"from": "a.html", "href": "sub/../b.html", "to": "b", "helper": "todo"},
    {"from": "a.html", "href": "my%20page.html", "to": "my page", "helper": "todo"},
    {"from": "a.html", "attr": "data-href", "href": "b.html", "to": "b"},
    {"from": "a.html", "attr": "onclick", "href": "location.href='b.html'", "to": "b"},
    {"from": "a.html", "attr": "onclick", "href": "go('../b.html')", "to": null, "helper": "todo"}
